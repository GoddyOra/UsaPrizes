---
import '../styles/global.css';
import { organizationSchema, websiteSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  schema?: object[]; // page-specific JSON-LD (Review, FAQPage, Article, etc.)
}

const { title, description, schema = [] } = Astro.props;
const siteName = 'USA Prizes';
const year = new Date().getFullYear();
const allSchema = [organizationSchema(), websiteSchema(), ...schema];
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    {allSchema.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- Google tag (gtag.js) -->
    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-R7STDF8GGR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-R7STDF8GGR');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">USA<span>Prizes</span></a>
        <nav class="primary-nav" aria-label="Primary">
          <ul>
            <li><a href="/lottery/">Lottery Results</a></li>
            <li><a href="/casinos/">Casino Reviews</a></li>
            <li><a href="/casinos/best-sweepstakes-casinos/">Best Sweepstakes Casinos</a></li>
            <li><a href="/guides/">Guides</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <h4>Lottery</h4>
            <ul>
              <li><a href="/lottery/powerball/">Powerball Results</a></li>
              <li><a href="/lottery/mega-millions/">Mega Millions Results</a></li>
              <li><a href="/lottery/">All Lottery Results</a></li>
            </ul>
          </div>
          <div>
            <h4>Casinos</h4>
            <ul>
              <li><a href="/casinos/best-sweepstakes-casinos/">Best Sweepstakes Casinos</a></li>
              <li><a href="/casinos/legal-by-state/">Legal By State</a></li>
              <li><a href="/casinos/">All Casino Reviews</a></li>
            </ul>
          </div>
          <div>
            <h4>Company</h4>
            <ul>
              <li><a href="/about/">About Us</a></li>
              <li><a href="/editorial-policy/">Editorial Policy</a></li>
              <li><a href="/guides/">Guides</a></li>
              <li><a href="mailto:hello@usaprizes.com">Contact / Corrections</a></li>
            </ul>
          </div>
          <div>
            <h4>Legal</h4>
            <ul>
              <li><a href="/disclaimer/">Disclaimer</a></li>
              <li><a href="/privacy-policy/">Privacy Policy</a></li>
              <li><a href="/terms/">Terms of Use</a></li>
            </ul>
          </div>
        </div>
        <div class="responsible-gaming">
          <p>
            <strong>18+ (21+ where required by law).</strong> USAPrizes.com is an independent
            informational and review site. We are not affiliated with any state lottery
            commission, and we do not operate, host, or offer real-money gambling, sweepstakes
            entries, or lottery tickets. Sweepstakes casinos featured on this site use a
            promotional sweepstakes model that is legally distinct from real-money online
            gambling; availability and legality vary by state and can change &mdash; always
            confirm current terms directly with the operator before playing. If gambling stops
            being fun, free and confidential help is available 24/7 from the National Problem
            Gambling Helpline: call or text 1-800-522-4700.
          </p>
          <p>&copy; {year} USAPrizes.com. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
