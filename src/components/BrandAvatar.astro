---
interface Props {
  name: string;
  size?: number;
}

const { name, size = 44 } = Astro.props;

const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();

// Deterministic hue from the brand name so each one gets a stable, distinct color
// across every page it appears on, without needing a logo image.
function hashHue(str: string) {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = (hash * 31 + str.charCodeAt(i)) >>> 0;
  }
  return hash % 360;
}
const hue = hashHue(name);
const bg = `linear-gradient(135deg, hsl(${hue}, 68%, 45%), hsl(${(hue + 42) % 360}, 68%, 36%))`;
---

<span
  class="brand-avatar"
  style={`width:${size}px;height:${size}px;font-size:${size * 0.38}px;background:${bg}`}
  aria-hidden="true"
>
  {initials}
</span>
