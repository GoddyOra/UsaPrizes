---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="faq-accordion">
  {items.map((item, i) => (
    <details class="faq-item" open={i === 0}>
      <summary>
        <span>{item.question}</span>
        <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
      </summary>
      <p>{item.answer}</p>
    </details>
  ))}
</div>
