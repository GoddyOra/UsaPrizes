---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { multiStateGames, nyGames } from '../../lib/lottery-games';
---

<BaseLayout
  title="Lottery Results by Game and State"
  description="Winning numbers for Powerball, Mega Millions, and state lottery games, updated after every drawing."
>
  <section class="hero">
    <div class="wrap">
      <Breadcrumbs items={[{ name: 'Lottery Results', href: '/lottery/' }]} />
      <p class="eyebrow">Lottery Results</p>
      <h1>Lottery results</h1>
      <p>Winning numbers for the multi-state games, plus individual state lotteries as we add them.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Multi-state games</h2>
      <div class="grid-cards">
        {multiStateGames.map((g) => (
          <a class="card" href={`/lottery/${g.slug}/`}>
            <h3>{g.name}</h3>
            <p>{g.desc}</p>
          </a>
        ))}
      </div>

      <h2>New York games</h2>
      <div class="grid-cards">
        {nyGames.map((g) => (
          <a class="card" href={`/lottery/${g.slug}/`}>
            <h3>{g.name}</h3>
            <p>{g.desc}</p>
          </a>
        ))}
      </div>

      <h2>Other states</h2>
      <p>Coming soon: Texas, Florida, Pennsylvania, Ohio, Georgia, North Carolina, Michigan, New Jersey, and more.</p>
    </div>
  </section>
</BaseLayout>
