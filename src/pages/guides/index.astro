---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Guides"
  description="Guides to how sweepstakes casinos work, redemption tips, and lottery basics."
>
  <section class="hero">
    <div class="wrap">
      <Breadcrumbs items={[{ name: 'Guides', href: '/guides/' }]} />
      <p class="eyebrow">Guides</p>
      <h1>Guides</h1>
      <p>Long-form, informational content on how sweepstakes casinos and lottery games work.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {guides.length > 0 ? (
        <div class="grid-cards">
          {guides.map((guide) => (
            <a class="card" href={`/guides/${guide.id}/`}>
              <h3>{guide.data.title}</h3>
              <p>{guide.data.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <p><em>First guides publish as part of the Phase 9 content cadence (2&ndash;3 new
        articles per week after launch).</em></p>
      )}
    </div>
  </section>
</BaseLayout>
