---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---

<BaseLayout title={guide.data.title} description={guide.data.description}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Guides</p>
      <h1>{guide.data.title}</h1>
      <p>{guide.data.description}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <p class="updated">
        Published {guide.data.publishDate.toISOString().slice(0, 10)}
        {guide.data.updatedDate && ` · Updated ${guide.data.updatedDate.toISOString().slice(0, 10)}`}
      </p>

      <Content />

      <div class="disclaimer-banner">
        This guide is for general informational purposes only and isn't legal, financial, or tax
        advice. See our <a href="/editorial-policy/">editorial policy</a>.
      </div>
    </div>
  </section>
</BaseLayout>
