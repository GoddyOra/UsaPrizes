---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="This page doesn't exist on USAPrizes.com — here's where to go instead."
>
  <section class="hero">
    <div class="wrap fade-in-up" style="text-align: center;">
      <p class="eyebrow" style="justify-content: center;">404</p>
      <h1>Page not found</h1>
      <p style="margin: 0 auto;">
        That page doesn't exist, or the URL changed. Here's where to find what you're
        looking for instead.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-cards">
        <a class="card" href="/lottery/">
          <h3>Lottery Results</h3>
          <p>Powerball, Mega Millions, and state results.</p>
        </a>
        <a class="card" href="/casinos/best-sweepstakes-casinos/">
          <h3>Best Sweepstakes Casinos</h3>
          <p>Our current ranked picks, compared.</p>
        </a>
        <a class="card" href="/guides/">
          <h3>Guides</h3>
          <p>How sweepstakes casinos work, redemption tips, and more.</p>
        </a>
        <a class="card" href="/">
          <h3>Home &rarr;</h3>
          <p>Back to the homepage.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
