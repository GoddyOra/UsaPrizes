---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import StarRating from '../../../components/StarRating.astro';
import BrandAvatar from '../../../components/BrandAvatar.astro';
import casinos from '../../../data/casinos.json';
import { faqPageSchema } from '../../../lib/schema';

const ranked = [...casinos].sort((a, b) => (b.rating ?? 0) - (a.rating ?? 0));

// Keep the comparison table scannable — full detail lives on each review's "at a glance" table.
function truncate(text, max = 70) {
  if (!text || text.length <= max) return text;
  const cut = text.slice(0, max);
  return cut.slice(0, cut.lastIndexOf(' ')) + '…';
}

const faq = [
  {
    question: 'What is the best sweepstakes casino overall?',
    answer:
      'Based on our reviews, Chumba Casino ranks highest overall for its long operating history, large slot library, and no-purchase-necessary welcome bonus — see the full ranking and comparison table below for how it compares on redemption speed and payment methods.',
  },
  {
    question: 'Are sweepstakes casinos legal?',
    answer:
      "Sweepstakes casinos use a promotional model — Gold Coins for free play plus Sweeps Coins redeemable for prizes — that's legally distinct from real-money online gambling under US sweepstakes law, and available in most states. Availability varies and can change; see our legal-by-state guide for the current picture.",
  },
  {
    question: 'How do I pick a sweepstakes casino?',
    answer:
      "It depends on what matters most to you: Chumba and Pulsz lean on longer track records, Stake.us offers fast crypto redemption, and WOW Vegas and McLuck cover a broader range of states. Compare redemption speed, payment methods, and state availability in the table below, then read the full review for any brand you're considering.",
  },
];

const schema = [faqPageSchema(faq)];
---

<BaseLayout
  title="Best Sweepstakes Casinos"
  description="Our current ranked picks for the best legal sweepstakes casinos in the U.S., compared on redemption speed, game selection, and state availability."
  schema={schema}
>
  <section class="hero">
    <div class="wrap">
      <Breadcrumbs items={[
        { name: 'Casino Reviews', href: '/casinos/' },
        { name: 'Best Sweepstakes Casinos', href: '/casinos/best-sweepstakes-casinos/' },
      ]} />
      <p class="eyebrow">Casino Reviews</p>
      <h1>Best sweepstakes casinos</h1>
      <p>
        Ranked by redemption speed, game selection, and state availability. Updated as legality
        and promotions change &mdash; see our <a href="/lottery/">lottery results</a> or the <a href="/casinos/legal-by-state/">legal-by-state guide</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <ol style="list-style: none; padding: 0; display: grid; gap: 1rem;">
        {ranked.map((c, i) => (
          <li class={`rank-row fade-in-up ${i < 3 ? `rank-${i + 1}` : ''}`}>
            <span class="rank-number">{i + 1}</span>
            <BrandAvatar name={c.name} size={44} />
            <div style="flex: 1;">
              <h3 style="margin: 0 0 0.2rem;"><a href={`/casinos/reviews/${c.slug}/`}>{c.name}</a></h3>
              <p style="margin: 0; color: var(--color-muted); font-size: 0.92rem;">{c.summary}</p>
            </div>
            {c.rating && <StarRating rating={c.rating} size={16} />}
          </li>
        ))}
      </ol>

      <h2>Full comparison</h2>
      <div style="overflow-x: auto;">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Casino</th>
              <th>Rating</th>
              <th>Welcome bonus</th>
              <th>Redemption</th>
            </tr>
          </thead>
          <tbody>
            {ranked.map((c) => (
              <tr>
                <td><a href={`/casinos/reviews/${c.slug}/`}>{c.name}</a></td>
                <td>{c.rating ? <StarRating rating={c.rating} size={14} /> : 'Review in progress'}</td>
                <td>{truncate(c.bonusOffer) ?? 'TBD'}</td>
                <td>{c.redemptionSpeed ? truncate(c.redemptionSpeed.split('.')[0] + '.') : 'TBD'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>FAQ</h2>
      {faq.map((item) => (
        <>
          <h3>{item.question}</h3>
          <p>{item.answer}</p>
        </>
      ))}

      <div class="disclaimer-banner">
        Rankings reflect our editorial judgment based on published reviews. Some links may be
        affiliate links &mdash; see our <a href="/editorial-policy/">editorial policy</a>.
      </div>
    </div>
  </section>
</BaseLayout>
