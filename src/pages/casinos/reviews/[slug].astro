---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import StarRating from '../../../components/StarRating.astro';
import BrandAvatar from '../../../components/BrandAvatar.astro';
import casinos from '../../../data/casinos.json';
import { reviewSchema, faqPageSchema } from '../../../lib/schema';

export function getStaticPaths() {
  return casinos.map((c) => ({
    params: { slug: c.slug },
    props: { casino: c },
  }));
}

const { casino } = Astro.props;

const title = casino.pros
  ? `${casino.name} Review 2026: Is It Legit? Bonuses & Redemption`
  : `${casino.name} Review`;

const schema = casino.pros
  ? [
      reviewSchema({
        itemName: casino.name,
        ratingValue: casino.rating,
        reviewBody: casino.verdict,
        datePublished: casino.reviewLastUpdated,
      }),
      faqPageSchema(casino.faq),
    ]
  : [];
---

<BaseLayout
  title={title}
  description={`${casino.name} review: redemption speed, payment methods, state availability, and promo code.`}
  schema={schema}
>
  <section class="hero">
    <div class="wrap">
      <Breadcrumbs items={[
        { name: 'Casino Reviews', href: '/casinos/' },
        { name: casino.name, href: `/casinos/reviews/${casino.slug}/` },
      ]} />
      <p class="eyebrow">Casino Reviews</p>
      <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem;">
        {casino.pros && <BrandAvatar name={casino.name} size={52} />}
        <h1 style="margin: 0; min-width: 0;">{casino.name} review</h1>
      </div>
      <p>{casino.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      {casino.pros ? (
        <>
          <div class="verdict-block fade-in-up">
            <StarRating rating={casino.rating} size={22} />
            <p>{casino.verdict}</p>
            <p class="byline">
              Reviewed by <a href="/editorial-policy/#reviewer">Mark Ora</a>, USA Prizes founder &mdash;
              see our <a href="/editorial-policy/#how-we-review">review methodology</a>.
              {' '}
              <span class={`badge ${casino.handsOnVerified ? 'badge-verified' : 'badge-pending'}`}>
                {casino.handsOnVerified ? '✓ Hands-on verified' : 'Desk research — verification pending'}
              </span>
            </p>
            <a class="cta-button" href={casino.officialUrl} target="_blank" rel="noopener">
              Visit {casino.name} &rarr;
            </a>
          </div>

          <h2>At a glance</h2>
          <table class="at-a-glance">
            <tbody>
              <tr><th>Welcome bonus</th><td>{casino.bonusOffer}</td></tr>
              <tr><th>Promo code</th><td>{casino.promoCode ?? 'None needed'}</td></tr>
              <tr><th>Redemption speed</th><td>{casino.redemptionSpeed}</td></tr>
              <tr><th>Payment methods</th><td>{casino.paymentMethods.join(', ')}</td></tr>
              <tr><th>State availability</th><td>Varies &mdash; see <a href="/casinos/legal-by-state/">legal by state</a></td></tr>
            </tbody>
          </table>

          <h2>Pros</h2>
          <ul class="icon-list">
            {casino.pros.map((pro) => (
              <li>
                <svg class="icon-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
                <span>{pro}</span>
              </li>
            ))}
          </ul>

          <h2>Cons</h2>
          <ul class="icon-list">
            {casino.cons.map((con) => (
              <li>
                <svg class="icon-x" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12" /></svg>
                <span>{con}</span>
              </li>
            ))}
          </ul>

          <h2>FAQ</h2>
          {casino.faq.map((item) => (
            <>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </>
          ))}

          <p class="updated">Review last updated: {casino.reviewLastUpdated}</p>

          <p>
            <em>How we tested:</em> {casino.handsOnVerified ? (
              'This review is based on hands-on account testing, including redemption, alongside cross-checked public research.'
            ) : (
              "This review is currently based on cross-checked public research (operator terms, independent reporting) rather than hands-on account testing — we haven't yet completed that verification step for this brand. It'll be marked as hands-on tested once we have."
            )} Bonus offers and state availability change often &mdash; always confirm current
            terms directly with the operator before playing. Full methodology: <a href="/editorial-policy/#how-we-review">how we review</a>.
          </p>
        </>
      ) : (
        <p><em>Full review in progress — pros/cons, redemption speed, payment methods, state
        availability, and promo code will be added here per the Phase 4 review template. Legal
        status is verified at publish time and re-checked on every refresh.</em></p>
      )}

      <div class="disclaimer-banner">
        Affiliate disclosure: some links on this page may be affiliate links. If you sign up
        through them we may earn a commission, at no cost to you. This never affects our rating.
      </div>
    </div>
  </section>
</BaseLayout>
