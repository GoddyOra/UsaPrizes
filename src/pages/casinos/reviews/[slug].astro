---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import casinos from '../../../data/casinos.json';
import { reviewSchema, faqPageSchema } from '../../../lib/schema';

export function getStaticPaths() {
  return casinos.map((c) => ({
    params: { slug: c.slug },
    props: { casino: c },
  }));
}

const { casino } = Astro.props;

const title = casino.pros
  ? `${casino.name} Review 2026: Is It Legit? Bonuses & Redemption`
  : `${casino.name} Review`;

const schema = casino.pros
  ? [
      reviewSchema({
        itemName: casino.name,
        ratingValue: casino.rating,
        reviewBody: casino.verdict,
        datePublished: casino.reviewLastUpdated,
      }),
      faqPageSchema(casino.faq),
    ]
  : [];
---

<BaseLayout
  title={title}
  description={`${casino.name} review: redemption speed, payment methods, state availability, and promo code.`}
  schema={schema}
>
  <section class="hero">
    <div class="wrap">
      <Breadcrumbs items={[
        { name: 'Casino Reviews', href: '/casinos/' },
        { name: casino.name, href: `/casinos/reviews/${casino.slug}/` },
      ]} />
      <p class="eyebrow">Casino Reviews</p>
      <h1>{casino.name} review</h1>
      <p>{casino.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      {casino.pros ? (
        <>
          <div class="verdict-block">
            <p class="rating"><strong>{casino.rating.toFixed(1)}/5</strong></p>
            <p>{casino.verdict}</p>
          </div>

          <h2>At a glance</h2>
          <table class="at-a-glance">
            <tbody>
              <tr><th>Welcome bonus</th><td>{casino.bonusOffer}</td></tr>
              <tr><th>Promo code</th><td>{casino.promoCode ?? 'None needed'}</td></tr>
              <tr><th>Redemption speed</th><td>{casino.redemptionSpeed}</td></tr>
              <tr><th>Payment methods</th><td>{casino.paymentMethods.join(', ')}</td></tr>
              <tr><th>State availability</th><td>Varies &mdash; see <a href="/casinos/legal-by-state/">legal by state</a></td></tr>
            </tbody>
          </table>

          <h2>Pros</h2>
          <ul>
            {casino.pros.map((pro) => <li>{pro}</li>)}
          </ul>

          <h2>Cons</h2>
          <ul>
            {casino.cons.map((con) => <li>{con}</li>)}
          </ul>

          <h2>FAQ</h2>
          {casino.faq.map((item) => (
            <>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </>
          ))}

          <p class="updated">Review last updated: {casino.reviewLastUpdated}</p>

          <p>
            <em>How we tested:</em> ratings and redemption/payment details reflect the operator's
            published terms and independent reporting at time of writing, cross-checked across
            multiple sources. Bonus offers and state availability change often &mdash; always
            confirm current terms directly with the operator before playing.
          </p>
        </>
      ) : (
        <p><em>Full review in progress — pros/cons, redemption speed, payment methods, state
        availability, and promo code will be added here per the Phase 4 review template. Legal
        status is verified at publish time and re-checked on every refresh.</em></p>
      )}

      <div class="disclaimer-banner">
        Affiliate disclosure: some links on this page may be affiliate links. If you sign up
        through them we may earn a commission, at no cost to you. This never affects our rating.
      </div>
    </div>
  </section>
</BaseLayout>
