---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import casinos from '../../data/casinos.json';
---

<BaseLayout
  title="Sweepstakes Casino Reviews"
  description="Independent reviews of the top legal sweepstakes casinos available in the U.S., covering redemption speed, payment methods, and state availability."
>
  <section class="hero">
    <div class="wrap">
      <Breadcrumbs items={[{ name: 'Casino Reviews', href: '/casinos/' }]} />
      <p class="eyebrow">Casino Reviews</p>
      <h1>Sweepstakes casino reviews</h1>
      <p>
        We review sweepstakes casinos on redemption speed, payment methods, game selection, and
        state availability. See our <a href="/casinos/best-sweepstakes-casinos/">current top picks</a>
        or check the <a href="/casinos/legal-by-state/">legal status in your state</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>All reviews</h2>
      <div class="grid-cards">
        {casinos.map((c) => (
          <a class="card" href={`/casinos/reviews/${c.slug}/`}>
            <h3>{c.name}</h3>
            <p>{c.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface); border-top: 1px solid var(--color-border);">
    <div class="wrap">
      <h2>Guides</h2>
      <div class="grid-cards">
        <a class="card" href="/guides/new-sweepstakes-casinos-2026/">
          <h3>New Sweepstakes Casinos in 2026</h3>
          <p>How to vet a new site before you join.</p>
        </a>
        <a class="card" href="/guides/sweepstakes-casino-kyc-verification/">
          <h3>KYC Verification Explained</h3>
          <p>What to expect and how to avoid delays.</p>
        </a>
        <a class="card" href="/guides/best-sweepstakes-casinos-slots-vs-table-games/">
          <h3>Slots vs. Table Games</h3>
          <p>Which brands actually offer blackjack and roulette.</p>
        </a>
        <a class="card" href="/guides/">
          <h3>All guides &rarr;</h3>
          <p>Browse the full library.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
